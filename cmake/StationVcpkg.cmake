# Local paths are generated by tools/windows/Build.ps1, never committed.
# Use this file's location: CMAKE_SOURCE_DIR changes inside try_compile().
get_filename_component(_minicam_source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_minicam_state "${_minicam_source}/out/station/environment.json")
if(NOT EXISTS "${_minicam_state}")
    message(FATAL_ERROR "Run PRZYGOTUJ_KOMPILACJE.cmd in the MiniCam folder first.")
endif()
file(READ "${_minicam_state}" _minicam_environment)
file(SHA256 "${_minicam_source}/tools/windows/toolchain.lock.json" _minicam_lock_hash)
string(JSON _minicam_prepared_hash GET "${_minicam_environment}" lockHash)
if(NOT _minicam_prepared_hash STREQUAL _minicam_lock_hash)
    message(FATAL_ERROR "Toolchain lock changed. Run PRZYGOTUJ_KOMPILACJE.cmd again.")
endif()
foreach(_key vcpkgRoot cacheRoot visualStudio ninja git jobs)
    string(JSON _minicam_${_key} GET "${_minicam_environment}" "${_key}")
endforeach()
file(READ "${_minicam_source}/tools/windows/toolchain.lock.json" _minicam_lock)
string(JSON _minicam_expected_commit GET "${_minicam_lock}" vcpkgCommit)
execute_process(COMMAND "${_minicam_git}" -C "${_minicam_vcpkgRoot}" rev-parse HEAD
    OUTPUT_VARIABLE _minicam_actual_commit OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _minicam_git_result ERROR_QUIET)
if(NOT _minicam_git_result EQUAL 0 OR NOT _minicam_actual_commit STREQUAL _minicam_expected_commit)
    message(FATAL_ERROR "Prepared vcpkg checkout does not match the lock. Run PRZYGOTUJ_KOMPILACJE.cmd.")
endif()
set(ENV{VCPKG_ROOT} "${_minicam_vcpkgRoot}")
set(ENV{VCPKG_DOWNLOADS} "${_minicam_cacheRoot}/downloads")
set(ENV{VCPKG_MAX_CONCURRENCY} "${_minicam_jobs}")
set(ENV{VCPKG_BINARY_SOURCES} "clear;files,${_minicam_cacheRoot}/binaries,readwrite")
file(TO_CMAKE_PATH "${_minicam_cacheRoot}/assets" _minicam_asset_path)
if(_minicam_asset_path MATCHES "^//")
    set(_minicam_asset_url "file:${_minicam_asset_path}/")
else()
    set(_minicam_asset_url "file:///${_minicam_asset_path}/")
endif()
string(REPLACE " " "%20" _minicam_asset_url "${_minicam_asset_url}")
set(ENV{X_VCPKG_ASSET_SOURCES} "clear;x-azurl,${_minicam_asset_url},,readwrite")
set(ENV{VCPKG_VISUAL_STUDIO_PATH} "${_minicam_visualStudio}")
set(CMAKE_MAKE_PROGRAM "${_minicam_ninja}" CACHE FILEPATH "Prepared Ninja" FORCE)
set(VCPKG_OVERLAY_TRIPLETS "${_minicam_source}/tools/windows/triplets" CACHE STRING "MiniCam toolsets" FORCE)
set(MINICAM_STATION_BUILD ON CACHE INTERNAL "Use the common Windows compiler")
include("${_minicam_vcpkgRoot}/scripts/buildsystems/vcpkg.cmake")
